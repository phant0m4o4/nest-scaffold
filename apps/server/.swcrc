{
  "$schema": "https://swc.rs/schema.json",
  "exclude": ["\\.d\\.ts$"],
  "sourceMaps": true,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "es2023"
  },
  "module": {
    "type": "commonjs"
  },
  "minify": false
}
