{
  "name": "@nest-scaffold/mobile-app",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint . --max-warnings 0",
    "lint": "eslint . --fix",
    "format": "prettier --write src app.config.ts package.json tsconfig.json eslint.config.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@nest-scaffold/api-client": "workspace:*",
    "@nest-scaffold/contracts": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  }
}
