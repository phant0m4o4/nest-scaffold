{
  "name": "nest-scaffold",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=\"development\" nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:dist": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism --test-timeout=0",
    "test:e2e": "vitest run --config ./vitest-e2e.config.ts",
    "db:init:dev": "cross-env NODE_ENV=\"development\" nest start --entryFile ./common/modules/database/mysql/tools/init.main",
    "db:seed:dev": "cross-env NODE_ENV=\"development\" nest start --entryFile ./common/modules/database/mysql/tools/seed.main",
    "db:init:prod": "cross-env NODE_ENV=\"production\" node dist/common/modules/database/mysql/tools/init.main",
    "db:seed:prod": "cross-env NODE_ENV=\"production\" node dist/common/modules/database/mysql/tools/seed.main",
    "db:push": "drizzle-kit push --config drizzle-mysql.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle-mysql.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle-mysql.config.ts",
    "db:init:pg:dev": "cross-env NODE_ENV=\"development\" nest start --entryFile ./common/modules/database/pgsql/tools/init.main",
    "db:seed:pg:dev": "cross-env NODE_ENV=\"development\" nest start --entryFile ./common/modules/database/pgsql/tools/seed.main",
    "db:init:pg:prod": "cross-env NODE_ENV=\"production\" node dist/common/modules/database/pgsql/tools/init.main",
    "db:seed:pg:prod": "cross-env NODE_ENV=\"production\" node dist/common/modules/database/pgsql/tools/seed.main",
    "db:push:pg": "drizzle-kit push --config drizzle-pgsql.config.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle-pgsql.config.ts",
    "db:migrate:pg": "drizzle-kit migrate --config drizzle-pgsql.config.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "argon2": "^0.44.0",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.70.1",
    "dayjs": "^1.11.19",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "inquirer": "^13.3.0",
    "ioredis": "^5.10.0",
    "mysql2": "^3.18.2",
    "nestjs-i18n": "^10.6.0",
    "nestjs-pino": "^4.6.0",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bull-board/api": "^6.20.3",
    "@bull-board/express": "^6.20.3",
    "@bull-board/nestjs": "^6.20.3",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "testcontainers": "^11.12.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.18"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
