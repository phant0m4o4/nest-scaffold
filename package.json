{
  "name": "nest-scaffold",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=\"development\" nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:dist": "node dist/main",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "commit": "cz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest-e2e.config.ts",
    "db:seed:mysql": "nest start --entryFile ./common/modules/database/mysql/tools/seed.main",
    "db:reset:mysql": "nest start --entryFile ./common/modules/database/mysql/tools/reset.main",
    "db:generate:mysql": "drizzle-kit generate --config drizzle-mysql.config.ts",
    "db:migrate:mysql": "drizzle-kit migrate --config drizzle-mysql.config.ts",
    "db:seed:pgsql": "nest start --entryFile ./common/modules/database/pgsql/tools/seed.main",
    "db:reset:pgsql": "nest start --entryFile ./common/modules/database/pgsql/tools/reset.main",
    "db:generate:pgsql": "drizzle-kit generate --config drizzle-pgsql.config.ts",
    "db:migrate:pgsql": "drizzle-kit migrate --config drizzle-pgsql.config.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "argon2": "^0.45.1",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.81.3",
    "dayjs": "^1.11.21",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "inquirer": "^14.0.2",
    "ioredis": "^6.0.0",
    "mysql2": "^3.23.2",
    "nanoid": "^6.0.1",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bull-board/api": "^8.5.0",
    "@bull-board/express": "^8.5.0",
    "@bull-board/nestjs": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
