logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# 环境变量(.env.example 保留入库)
.env
.env.local
.env.*.local

# 操作系统
.DS_Store

# IDE / 编辑器
/.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
