APP_NAME=nest-scaffold
APP_PORT=3000
# 应用主密钥：必须是 32 字节高熵随机材料，以 64 位 hex 写入 env。
# 原因：AES-256-GCM 的密钥长度固定为 256 bit（32 字节）；此处直接把解码后的字节当 key，
# 不经口令派生，所以 env 必须正好是 32 字节，而不能是任意短串再哈希。
# 生成（生产务必替换示例值）：openssl rand -hex 32
APP_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# CORS 允许来源白名单（英文逗号分隔，精确匹配协议+域名+端口）。
# 留空或含 `*` 表示允许任意来源。生产环境若留空 / `*`+凭证，启动时打 warning、不阻断
# （常见于 CDN / Nginx / API Gateway 已统一管 CORS；本服务直接对外时请配具体白名单）。
# APP_CORS_DOMAINS=https://a.example.com,https://b.example.com
# 是否允许跨域请求携带 Cookie，默认 true（本项目使用 Cookie Session）。
# APP_CORS_CREDENTIALS=true
# 是否信任反向代理的 X-Forwarded-For。默认 false（不信任，req.ip 取 TCP 对端地址，客户端伪造不了）。
# 只有确实部署在 CDN / Nginx / 负载均衡之后才开启，否则任何人都能伪造该头绕过限流与 IP 名单。
# 推荐填代理层数而非 true：APP_TRUST_PROXY=1；也支持 loopback / uniquelocal / IP 段列表
APP_TRUST_PROXY=false

#MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=${APP_NAME}
MYSQL_USER=root
MYSQL_PASSWORD=root_password

#PostgreSQL（与 MySQL 平行的可选数据源，按需使用）
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=${APP_NAME}
PGSQL_USER=postgres
PGSQL_PASSWORD=root_password

#Redis 公共锚点变量（应用不直接读取，仅供下方各模块的 *_REDIS_* 通过 ${...} 引用，避免重复书写）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
# sentinel / cluster 部署时先在此定义公共锚点，再在各模块段引用（模块段有对应注释示例）：
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_SENTINELS=10.0.0.1:26379,10.0.0.2:26379
# REDIS_CLUSTER_NODES=10.0.0.1:7000,10.0.0.2:7001
# 各模块连接自带命名空间（缺失直接启动报错，不会回退读其他模块的配置）

#Log
LOG_FILE_ENABLE=true
LOG_FILE_PATH=./logs/app.log

#Cache（自带连接配置；必须用独立 DB：缓存可随时清空/被淘汰，禁止与锁/队列等不可丢数据的服务共用一个 DB；cluster 模式无 DB 概念，需为缓存部署独立集群）
CACHE_TTL_SECONDS=604800 # 7 days
CACHE_KEY_PREFIX=cache
CACHE_REDIS_HOST=${REDIS_HOST}
CACHE_REDIS_PORT=${REDIS_PORT}
CACHE_REDIS_PASSWORD=${REDIS_PASSWORD}
CACHE_REDIS_DB=0
# sentinel 模式：
# CACHE_REDIS_MODE=sentinel
# CACHE_REDIS_SENTINEL_MASTER_NAME=${REDIS_SENTINEL_MASTER_NAME}
# CACHE_REDIS_SENTINELS=${REDIS_SENTINELS}
# cluster 模式（无 DB 概念，需为缓存独立集群；切换时须移除上面的 CACHE_REDIS_DB，否则启动报错）：
# CACHE_REDIS_MODE=cluster
# CACHE_REDIS_CLUSTER_NODES=${REDIS_CLUSTER_NODES}

#Distributed Lock（自带连接配置；独立 DB：锁数据不可丢，禁止与缓存等可随时清空的数据共用 DB）
DISTRIBUTED_LOCK_KEY_PREFIX=distributed-lock
DISTRIBUTED_LOCK_REDIS_HOST=${REDIS_HOST}
DISTRIBUTED_LOCK_REDIS_PORT=${REDIS_PORT}
DISTRIBUTED_LOCK_REDIS_PASSWORD=${REDIS_PASSWORD}
DISTRIBUTED_LOCK_REDIS_DB=1
# sentinel 模式：
# DISTRIBUTED_LOCK_REDIS_MODE=sentinel
# DISTRIBUTED_LOCK_REDIS_SENTINEL_MASTER_NAME=${REDIS_SENTINEL_MASTER_NAME}
# DISTRIBUTED_LOCK_REDIS_SENTINELS=${REDIS_SENTINELS}
# cluster 模式（无 DB 概念，需为锁独立部署；切换时须移除上面的 DISTRIBUTED_LOCK_REDIS_DB，否则启动报错）：
# DISTRIBUTED_LOCK_REDIS_MODE=cluster
# DISTRIBUTED_LOCK_REDIS_CLUSTER_NODES=${REDIS_CLUSTER_NODES}

#Queue（自带连接配置；BullMQ 必须独享连接，独立 DB：队列数据不可丢，禁止与缓存/锁共用）
QUEUE_REDIS_HOST=${REDIS_HOST}
QUEUE_REDIS_PORT=${REDIS_PORT}
QUEUE_REDIS_PASSWORD=${REDIS_PASSWORD}
QUEUE_REDIS_DB=2
# sentinel 模式：
# QUEUE_REDIS_MODE=sentinel
# QUEUE_REDIS_SENTINEL_MASTER_NAME=${REDIS_SENTINEL_MASTER_NAME}
# QUEUE_REDIS_SENTINELS=${REDIS_SENTINELS}
# cluster 模式（BullMQ 由模块创建 Cluster 实例接入；切换时须移除上面的 QUEUE_REDIS_DB，否则启动报错）：
# QUEUE_REDIS_MODE=cluster
# QUEUE_REDIS_CLUSTER_NODES=${REDIS_CLUSTER_NODES}
QUEUE_KEY_PREFIX=queue
QUEUE_DASHBOARD_ROUTE=/queues

#I18n（可选，默认 en）
# I18N_FALLBACK_LANGUAGE=en

#Bottleneck（可选的限流模块，默认未在 AppModule 装配；mode 为 memory 或 redis，默认 memory）
# BOTTLENECK_MODE=memory
# redis 模式下连接自带且必填（HOST/PORT/DB）：
# BOTTLENECK_REDIS_KEY_PREFIX=bottleneck
# BOTTLENECK_REDIS_HOST=${REDIS_HOST}
# BOTTLENECK_REDIS_PORT=${REDIS_PORT}
# BOTTLENECK_REDIS_PASSWORD=${REDIS_PASSWORD}
# BOTTLENECK_REDIS_DB=3
# sentinel / cluster 模式与其他模块同形：BOTTLENECK_REDIS_MODE + BOTTLENECK_REDIS_SENTINEL_MASTER_NAME=${REDIS_SENTINEL_MASTER_NAME} 等（cluster 须移除 DB，否则启动报错）
